{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SanjabOS",
  "version": "4.0.0",
  "identifier": "ir.sunjob.sanjabos",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "",
    "frontendDist": "./static"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Education",
    "copyright": "© SunJob — SanjabOS",
    "shortDescription": "سیستم‌عامل آموزشی فارسی",
    "longDescription": "SanjabOS — a Persian educational operating-system environment with Python (real CPython via Pyodide), Rust academy, Linux (real kernel via v86), PowerShell academy, AI academy and Persian writing tools.",
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "externalBin": ["binaries/node"],
    "resources": ["server-dist/*"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Persian", "English"]
      }
    }
  }
}
